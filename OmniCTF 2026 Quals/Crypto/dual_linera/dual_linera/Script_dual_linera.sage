"""

def solve():
    data = json.loads(data_json)
    q1 = int(data['q1'])
    q2 = int(data['q2'])
    samples = data['samples']
    flag_hex = data['flag_ciphertext']
    N = len(samples)

    # 1. Transform variables to eliminate the error 'e'
    # By subtracting the samples, we derived:
    # A_i * s - B_i ≡ -k_2 (mod q1)
    # where k_2 is bounded by 2^96. This sets us up perfectly for HNP.
    A_list = []
    B_list = []
    
    # Calculate modular inverse of q2 modulo q1
    inv_q2 = pow(q2, -1, q1)

    for samp in samples:
        a1 = int(samp['a1'])
        a2 = int(samp['a2'])
        y1 = int(samp['y1'])
        y2 = int(samp['y2'])

        A_i = ((a1 - a2) * inv_q2) % q1
        B_i = ((y1 - y2) * inv_q2) % q1
        
        A_list.append(A_i)
        B_list.append(B_i)

    # 2. Build the HNP Lattice
    # We construct a matrix of size (N+2) x (N+2)
    # Target weight W bounds the target value close to 2^96 
    # to balance it with the other unknown components in the vector
    W = 2**96
    M = Matrix(ZZ, N + 2, N + 2)
    
    # Fill s row (Row 0)
    M[0, 0] = 1
    for i in range(N):
        M[0, 2 + i] = A_list[i]
        
    # Fill modulus rows (Rows 1 to N)
    for i in range(N):
        M[1 + i, 2 + i] = q1
        
    # Fill affine shift row (Row N+1)
    M[N + 1, 1] = W
    for i in range(N):
        M[N + 1, 2 + i] = B_list[i]

    print("[*] Running LLL lattice reduction...")
    L = M.LLL()

    # 3. Search for our target vector containing 's'
    # We expect the shift column multiplier to be exactly 1 or -1 (scaled by W)
    secret = None
    for row in L:
        if row[1] == -W:
            secret = row[0]
            break
        elif row[1] == W:
            secret = -row[0] # Handle sign flip
            break

    if secret is not None:
        print(f"[+] Found secret: {secret}")
        
        # 4. Decrypt the flag
        key = hashlib.sha256(str(int(secret)).encode()).digest()
        flag_ciphertext = bytes.fromhex(flag_hex)
        stream = hashlib.shake_256(key).digest(len(flag_ciphertext))
        flag = bytes(operator.xor(a, b) for a, b in zip(flag_ciphertext, stream))
        
        print(f"\n[+] Flag: {flag.decode('utf-8')}")
    else:
        print("[-] Failed to find the secret.")

if __name__ == "__main__":
    solve()